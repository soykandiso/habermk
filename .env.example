# Copy to .env for local runs (".env" is git-ignored). In GitHub these are Secrets.
# Only the AI keys are needed for the Phase 0 evaluation.
GROQ_API_KEY=
GEMINI_API_KEY=
# optional, only for comparing paid quality in the eval
ANTHROPIC_API_KEY=

# Phase 1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Phase 2
FB_PAGE_ID=
FB_PAGE_TOKEN=

# manual = drafts wait for your ✅ in Telegram; auto = post without asking
APPROVAL_MODE=manual
# 1 = send drafts but never publish
DRY_RUN=0
